  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fanqie2025/dsh-superpowers-desktop.git"
  },
  "homepage": "https://github.com/fanqie2025/dsh-superpowers-desktop#readme",
  "bugs": {
    "url": "https://github.com/fanqie2025/dsh-superpowers-desktop/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "superpowers",
    "skills",
    "agent",
